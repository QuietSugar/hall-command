#!/bin/bash

# ====================================================
#   Git post-commit hook
#   根据 VERSION 文件自动创建对应 tag（如果该 tag 不存在）
# ====================================================

set -e

# 获取仓库根目录
repo_root="$(git rev-parse --show-toplevel)"
version_file="${repo_root}/VERSION"

if [ ! -f "$version_file" ]; then
    echo "[hall-command hook] VERSION 文件不存在，跳过创建 tag"
    exit 0
fi

version=$(tr -d '[:space:]' < "$version_file")

if [ -z "$version" ]; then
    echo "[hall-command hook] VERSION 文件内容为空，跳过创建 tag"
    exit 0
fi

# 检查 tag 是否已存在
if git rev-parse "refs/tags/${version}" >/dev/null 2>&1; then
    echo "[hall-command hook] tag ${version} 已存在"
    exit 0
fi

# 创建 tag
git tag "$version"
echo "[hall-command hook] 已创建 tag: ${version}"
